# 统一换行符为 LF，避免 Windows 编辑产生的 CRLF 噪音污染 git status
* text=auto eol=lf

# 显式声明二进制文件，防止被误判为文本
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.zip binary
*.tar binary
*.gz binary

# 构建产物/缓存按 LF 文本处理
*.tsbuildinfo text
*.lock text
